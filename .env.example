# Optional overrides. Native subscription logins are used by default.
# Do not add API keys: this workflow is subscription-only.
# CODEX_HOME=/absolute/path/to/your/codex-home
# CLAUDE_CONFIG_DIR=/absolute/path/to/your/claude-config
# For custom LIVE usage readers; each prints the normalized JSON documented in README.md.
# CLAUDE_USAGE_COMMAND=/absolute/path/to/claude-usage-reader
# CODEX_USAGE_COMMAND=/absolute/path/to/codex-usage-reader
# CLAUDE_USAGE_TOKEN_COMMAND=/absolute/path/to/profile-scoped-claude-token-reader
